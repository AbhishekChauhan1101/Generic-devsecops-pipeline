# =============================================================================
#  iis.env.example - settings read by the IIS PowerShell scripts (scripts/iis-*.ps1, health-check.ps1)
#
#  In Jenkins these values are exported automatically from the CFG block of the Jenkinsfile.
#  For a MANUAL run on the IIS server (e.g. emergency rollback) load them in PowerShell, e.g.:
#
#      Get-Content config\iis.env | Where-Object { $_ -match '^\s*[A-Z_]+=' } | ForEach-Object {
#          $k, $v = $_ -split '=', 2; Set-Item -Path ("env:" + $k.Trim()) -Value $v.Trim() }
#      .\scripts\iis-rollback.ps1
#
#  (copy this file to config\iis.env first - iis.env is git-ignored). Run PowerShell as Administrator.
#  NEVER put passwords or tokens in this file.
# =============================================================================

APP_NAME=my-app
DEPLOY_ENV=dev

# ---- build -------------------------------------------------------------------
DOTNET_PROJECT=src/MyApp.Web/MyApp.Web.csproj      # project to publish (relative to the repo root)
DOTNET_CONFIGURATION=Release
DOTNET_PUBLISH_ARGS=
PUBLISH_DIR=publish

# ---- IIS target ----------------------------------------------------------------
IIS_SITE_NAME=MyAppSite                            # site name exactly as shown in IIS Manager (path + pool are then read from IIS)
IIS_APPLICATION=                                   # optional virtual application under the site
IIS_APP_POOL=                                      # optional - read from IIS when empty (must match IIS if set)
IIS_SITE_PATH=                                     # optional - read from IIS when empty. If you set it, also set the prefixes below
IIS_ALLOWED_PATH_PREFIXES=                         # only needed with IIS_SITE_PATH, e.g. D:\Sites
# Not sure what exists? run .\scripts\iis-discover.ps1 on the server (or Jenkins ACTION=discover-iis)
IIS_CREATE_PATH=false                              # true only for a first deployment
IIS_REQUIRE_WEB_CONFIG=true

# ---- backup / safety --------------------------------------------------------------
IIS_BACKUP_ROOT=D:\Backups\IIS                     # outside IIS_SITE_PATH; backups: <root>\<APP_NAME>\yyyy-MM-dd_HHmmss
IIS_BACKUP_KEEP=10
IIS_PRESERVE_PATHS=logs,App_Data,uploads           # never overwritten / deleted / backed up (add web.config to keep the server's)
IIS_PURGE=true                                     # true = mirror (remove files not in the new build)
IIS_STRATEGY=app_offline                           # app_offline (default, no pool stop) | stop_pool
IIS_STOP_TIMEOUT_SEC=60
IIS_GRANT_PERMISSIONS=false                        # true = grant the app pool identity read (and modify on IIS_WRITABLE_PATHS)
IIS_WRITABLE_PATHS=logs
ROLLBACK_ENABLED=true

# ---- health check -----------------------------------------------------------------
HEALTH_CHECK_URL=https://myapp.example.com/health
HEALTH_CHECK_RETRIES=10
HEALTH_CHECK_DELAY=6
HEALTH_CHECK_TIMEOUT=15
HEALTH_EXPECTED_STATUS=200
HEALTH_SKIP_TLS_VERIFY=false
