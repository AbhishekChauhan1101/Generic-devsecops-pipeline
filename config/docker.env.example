# =============================================================================
#  docker.env.example - settings read by the Docker scripts (scripts/docker-*.sh, health-check.sh)
#
#  In Jenkins these values are exported automatically from the CFG block of the Jenkinsfile.
#  This file is for running a script BY HAND on a Linux host (e.g. an emergency rollback):
#      cp config/docker.env.example config/docker.env      # docker.env is git-ignored
#      set -a; . config/docker.env; set +a
#      bash scripts/docker-rollback.sh
#
#  NEVER put passwords, tokens or AWS keys in this file.
#  Credentials come from Jenkins (credentials binding) or from the host's IAM role / `aws configure`.
# =============================================================================

APP_NAME=my-app
DEPLOY_ENV=dev                         # dev | staging | production (used for the state folder and labels)

# ---- image -------------------------------------------------------------------
DOCKER_IMAGE=my-app                    # image name (without registry); defaults to APP_NAME
DOCKERFILE_PATH=Dockerfile
DOCKER_CONTEXT=.
IMAGE_TAG=1-abc1234                    # immutable tag: <BUILD_NUMBER>-<git sha>  (set by Jenkins)
DOCKER_BUILD_ARGS=                     # e.g. "--build-arg BUILD_CONFIGURATION=Release"  (no secrets!)

# ---- registry: ecr | generic | none ---------------------------------------------
REGISTRY_TYPE=ecr
AWS_REGION=eu-west-1
ECR_REGISTRY=                          # empty = derived from the AWS account (aws sts get-caller-identity)
ECR_REPOSITORY=my-app
ECR_CREATE_REPO=false
# REGISTRY_URL=registry.example.com    # for REGISTRY_TYPE=generic
# REGISTRY_REPOSITORY=team/my-app
# REGISTRY_USER / REGISTRY_PASSWORD are injected by Jenkins credentials - do not store them here.
DOCKER_PUSH_LATEST=false               # keep false: immutable tags only

# ---- container ---------------------------------------------------------------
DOCKER_CONTAINER=my-app
DOCKER_HOST_PORT=8080
DOCKER_CONTAINER_PORT=8080
DOCKER_NETWORK=
DOCKER_EXTRA_RUN_ARGS=                 # e.g. "--memory 512m --cpus 1"
DOCKER_ENV_FILE=                       # path to a runtime env file ON THE HOST (outside Git)
DOCKER_ALLOW_NEW_PRIVILEGES=false      # false = run with --security-opt no-new-privileges
DOCKER_KEEP_PREVIOUS_CONTAINER=false
DOCKER_KEEP_IMAGES=5                   # old images of this repository to keep on the host
DEPLOY_STATE_DIR=                      # default: $HOME/.devsecops-deploy

# ---- health check ------------------------------------------------------------
HEALTH_CHECK_URL=http://localhost:8080/health
HEALTH_CHECK_RETRIES=10
HEALTH_CHECK_DELAY=6
HEALTH_CHECK_TIMEOUT=15
HEALTH_EXPECTED_STATUS=200
HEALTH_SKIP_TLS_VERIFY=false

# ---- security scans (used by scripts/trivy-scan.sh) --------------------------------
TRIVY_SEVERITY=HIGH,CRITICAL
TRIVY_EXIT_CODE=1                      # 0 = report only
TRIVY_SCANNERS=vuln,secret
TRIVY_IGNORE_UNFIXED=false
TRIVY_USE_DOCKER=false
